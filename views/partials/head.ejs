<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= siteName %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📚</text></svg>">
</head>
<body>
<header class="topbar">
  <div class="container topbar-inner">
    <a href="/" class="brand">📚 <%= siteName %></a>
    <nav>
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Cours</a>
      <% if (isAdmin) { %>
        <a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>">Admin</a>
        <form method="post" action="/admin/logout" class="inline"><button class="link">Déconnexion</button></form>
      <% } else { %>
        <a href="/admin">Admin</a>
      <% } %>
      <button class="link theme-toggle" type="button" title="Changer de thème" aria-label="Changer de thème">🌓</button>
    </nav>
  </div>
</header>
<main class="container">
<% if (flash) { %><div class="flash"><%= flash %></div><% } %>
