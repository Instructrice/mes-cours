<% if (error) { %><div class="flash error"><%= error %></div><% } %>
<label>Titre *
  <input name="title" value="<%= course.title || '' %>" required maxlength="200">
</label>
<label>Catégorie
  <input name="category" value="<%= course.category || '' %>" list="categories" placeholder="ex. Programmation, Langues…">
  <datalist id="categories"><% categories.forEach(c => { %><option value="<%= c %>"><% }) %></datalist>
</label>
<label>Description <small class="muted">(Markdown accepté)</small>
  <textarea name="description" rows="5"><%= course.description || '' %></textarea>
</label>
<label>Image de couverture (URL) <small class="muted">— vide : miniature de la 1ʳᵉ vidéo</small>
  <input name="cover_url" type="url" value="<%= course.cover_url || '' %>" placeholder="https://…">
</label>
<label class="checkbox">
  <input type="checkbox" name="published" <%= course.published ? 'checked' : '' %>> Publier ce cours (visible par tous)
</label>
