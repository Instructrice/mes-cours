<%- include('../partials/head') %>
<a href="/admin/cours/<%= course.id %>" class="back">← <%= course.title %></a>
<% const isNew = !lesson.id; %>
<form class="panel" method="post" action="<%= isNew ? `/admin/cours/${course.id}/lecons` : `/admin/lecons/${lesson.id}` %>">
  <h1><%= isNew ? 'Nouvelle leçon' : 'Modifier la leçon' %></h1>
  <% if (error) { %><div class="flash error"><%= error %></div><% } %>

  <label>Titre *
    <input name="title" value="<%= lesson.title || '' %>" required maxlength="200" autofocus>
  </label>

  <label>Vidéo YouTube <small class="muted">(lien de la vidéo, optionnel)</small>
    <input name="youtube_url" value="<%= lesson.youtube_url || '' %>" data-yt-input
           placeholder="https://www.youtube.com/watch?v=… ou https://youtu.be/…">
  </label>
  <div class="video preview" data-yt-preview hidden></div>

  <label>Contenu de la leçon <small class="muted">(Markdown : # titres, **gras**, listes, `code`, liens…)</small>
    <textarea name="content" rows="16" class="mono" data-md-input><%= lesson.content || '' %></textarea>
  </label>
  <details>
    <summary>Aperçu du contenu</summary>
    <div class="prose preview-box" data-md-preview></div>
  </details>

  <div class="row">
    <button class="btn">Enregistrer</button>
    <% if (isNew) { %><button class="btn ghost" name="again" value="1">Enregistrer et ajouter une autre</button><% } %>
    <% if (!isNew) { %><a class="btn ghost" href="/cours/<%= course.slug %>/lecon/<%= lesson.id %>">Voir la leçon</a><% } %>
  </div>
</form>
<script src="/vendor/marked.umd.js"></script>
<%- include('../partials/foot') %>
