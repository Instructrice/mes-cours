<%- include('../partials/head') %>
<a href="/admin" class="back">← Tous les cours</a>
<div class="page-head">
  <h1><%= course.title %></h1>
  <a class="btn ghost" href="/cours/<%= course.slug %>">Voir le cours</a>
</div>

<div class="two-cols">
  <form class="panel" method="post" action="/admin/cours/<%= course.id %>">
    <h2>Informations</h2>
    <%- include('course-fields') %>
    <div class="row">
      <button class="btn">Enregistrer</button>
    </div>
  </form>

  <section class="panel" id="lecons">
    <div class="page-head">
      <h2>Leçons (<%= lessons.length %>)</h2>
      <a class="btn" href="/admin/cours/<%= course.id %>/lecons/nouvelle">+ Ajouter une leçon</a>
    </div>
    <% if (!lessons.length) { %><p class="muted">Aucune leçon. Ajoutez la première !</p><% } %>
    <ol class="admin-lessons">
      <% lessons.forEach((l, i) => { %>
        <li>
          <% const thumb = thumbnailUrl(l.youtube_url); %>
          <% if (thumb) { %><img src="<%= thumb %>" alt="" loading="lazy"><% } else { %><span class="no-thumb">📝</span><% } %>
          <a href="/admin/lecons/<%= l.id %>" class="grow"><%= i + 1 %>. <%= l.title %></a>
          <form method="post" action="/admin/lecons/<%= l.id %>/deplacer" class="inline">
            <button class="icon" name="dir" value="up" title="Monter" <%= i === 0 ? 'disabled' : '' %>>↑</button>
            <button class="icon" name="dir" value="down" title="Descendre" <%= i === lessons.length - 1 ? 'disabled' : '' %>>↓</button>
          </form>
          <form method="post" action="/admin/lecons/<%= l.id %>/supprimer" class="inline" data-confirm="Supprimer la leçon « <%= l.title %> » ?">
            <button class="icon danger" title="Supprimer">✕</button>
          </form>
        </li>
      <% }) %>
    </ol>
  </section>
</div>

<form method="post" action="/admin/cours/<%= course.id %>/supprimer" class="danger-zone"
      data-confirm="Supprimer définitivement ce cours et toutes ses leçons ?">
  <button class="btn danger">Supprimer le cours</button>
</form>
<%- include('../partials/foot') %>
