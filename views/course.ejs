<%- include('partials/head') %>
<% if (!course.published) { %><div class="flash warn">Aperçu : ce cours n'est pas encore publié.</div><% } %>
<div class="course-header">
  <%- include('partials/cover', { course: { ...course, first_video: lessons.find(l => l.youtube_url)?.youtube_url } }) %>
  <div>
    <% if (course.category) { %><span class="tag"><%= course.category %></span><% } %>
    <h1><%= course.title %></h1>
    <div class="prose"><%- md(course.description) %></div>
    <div class="progress" data-course-progress="<%= course.id %>" data-total="<%= lessons.length %>">
      <div class="bar"></div>
    </div>
    <p class="muted progress-label" data-progress-label="<%= course.id %>"></p>
    <% if (lessons.length) { %>
      <a class="btn" data-resume="<%= course.id %>" data-slug="<%= course.slug %>"
         data-ids="<%= lessons.map(l => l.id).join(',') %>"
         href="/cours/<%= course.slug %>/lecon/<%= lessons[0].id %>">Commencer le cours</a>
    <% } %>
    <% if (isAdmin) { %><a class="btn ghost" href="/admin/cours/<%= course.id %>">Modifier</a><% } %>
  </div>
</div>

<h2>Programme</h2>
<% if (!lessons.length) { %><p class="muted">Aucune leçon pour l'instant.</p><% } %>
<ol class="lesson-list">
  <% lessons.forEach((l, i) => { %>
    <li data-lesson="<%= l.id %>" data-course="<%= course.id %>">
      <a href="/cours/<%= course.slug %>/lecon/<%= l.id %>">
        <span class="num"><%= i + 1 %></span>
        <span class="lesson-title"><%= l.title %></span>
        <% if (youtubeId(l.youtube_url)) { %><span class="badge">▶ vidéo</span><% } %>
        <span class="check" aria-hidden="true">✓</span>
      </a>
    </li>
  <% }) %>
</ol>
<%- include('partials/foot') %>
